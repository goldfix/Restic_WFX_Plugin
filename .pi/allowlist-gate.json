{
  "enabled": true,
  "allow": [
    "shell:git status *",
    "shell:git diff *",
    "shell:git log *",
    "shell:ls *",
    "shell:cat *",
    "shell:pwd *",
    "shell:echo *",
    "shell:wc *",
    "shell:grep *",
    "shell:tail *",
    "mcp:docs-mcp-server",
    "shell:git show *",
    "shell:find *",
    "shell:./build.sh clean",
    "shell:./build.sh debug",
    "shell:./build.sh test",
    "shell:./build.sh analyze",
    "shell:./build.sh asan",
    "shell:./build.sh release",
    "shell:rm -f build.pdb",
    "shell:ls -la build",
    "shell:nmake /nologo clean",
    "shell:nmake /nologo CONFIG=Debug all",
    "shell:nmake -nologo clean",
    "shell:nmake -nologo CONFIG=Debug all",
    "shell:tmp/restic.exe *",
    "shell:RESTIC_REPOSITORY=\"tmp/sample_repo\" RESTIC_PASSWORD=\"testpassword123\" MSYS2_ARG_CONV_EXCL=\"*\" tmp/restic.exe *",
    "shell:cat -n *",
    "shell:sed -n *",
    "shell:sed *",
    "shell:cut *",
    "shell:cd *",
    "shell:head *",
    "shell:python *",
    "shell:od *",
    "shell:python - <<'PY' *",
    "edit:tmp *",
    "shell:sort *",
    "edit:tmp/ *"
  ],
  "deny": []
}
